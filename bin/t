#!/usr/bin/env bash

set -u

if ! command -v fzf >/dev/null 2>&1; then
    printf 't: fzf is required but is not installed\n' >&2
    exit 1
fi

if ! tmux has-session 2>/dev/null; then
    printf 'No tmux sessions.\n'
    exit 0
fi

rows=()
index=1

while IFS=$'\t' read -r session_id session_name windows status; do
    rows+=("$index"$'\t'"$session_id"$'\t'"$session_name"$'\t'"$windows windows"$'\t'"$status")
    ((index += 1))
done < <(tmux list-sessions -F $'#{session_id}\t#{session_name}\t#{session_windows}\t#{?session_attached,attached,detached}')

selected=$(
    printf '%s\n' "${rows[@]}" |
        fzf \
            --delimiter=$'\t' \
            --with-nth=1,3,4,5 \
            --height=40% \
            --layout=reverse \
            --border \
            --prompt='tmux> ' \
            --header='number  session  windows  status'
) || exit 0

IFS=$'\t' read -r _ session_id _ <<< "$selected"

if [[ -n ${TMUX:-} ]]; then
    exec tmux switch-client -t "$session_id"
else
    exec tmux attach-session -t "$session_id"
fi
